#!/usr/bin/env sh

# foreman is a bundled dependency (development group) and is run through the
# project binstub at bin/foreman. The binstub loads the gem directly via
# Bundler, so it works regardless of how `foreman` resolves on PATH — in
# particular it sidesteps the mise `foreman` shim, which is on PATH but errors
# at runtime when foreman isn't activated as a mise tool in this directory.
#
# If the binstub is missing (fresh checkout before `bin/setup`), regenerate it.
if [ ! -x bin/foreman ]; then
  echo "bin/foreman binstub missing; generating it..."
  bundle binstubs foreman
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec bin/foreman start -f Procfile.dev "$@"
