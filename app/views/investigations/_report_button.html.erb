<div id="investigation_report_<%= investigation.id %>">
  <% if investigation.completed? %>
    <button type="button"
            class="text-mute hover:text-cyan text-[10px]"
            data-controller="copy"
            data-action="click->copy#copySummary"
            data-copy-text-value="<%= Investigations::ReportGenerator.new(investigation).to_markdown %>">[y] copy report</button>
  <% else %>
    <span class="text-mute text-[10px]">report pending…</span>
  <% end %>
</div>
