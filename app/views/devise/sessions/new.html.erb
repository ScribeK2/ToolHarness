<div class="min-h-screen flex items-center justify-center bg-bg">
  <div class="border border-line bg-surface w-[360px] p-6 font-mono text-xs">
    <div class="text-fg font-bold tracking-[0.14em] mb-4">▸ TOOLHARNESS</div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-3" }) do |f| %>
      <div>
        <%= f.label :email, "email", class: "mono-label block mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>
      <div>
        <%= f.label :password, "password", class: "mono-label block mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2 text-fg-dim">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit "SIGN IN ⏎", class: "btn btn-primary cursor-pointer w-full" %>
      </div>

      <div class="text-mute pt-3 border-t border-line mt-3">
        local instance · v0.1
      </div>
    <% end %>
  </div>
</div>
