<% content_for :title, "Dashboard · ToolHarness" %>

<%# Header %>
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="text-3xl font-bold mb-1">Dashboard</h1>
    <p class="text-ink-dim text-sm">Diagnostic activity for <span class="font-mono"><%= current_user.email %></span>.</p>
  </div>
  <%= link_to tools_path, class: "btn btn-primary" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    Browse tools
  <% end %>
</div>

<%# Stat tiles %>
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
  <div class="card p-4">
    <div class="text-xs text-ink-mute uppercase tracking-wider mb-1">Total runs</div>
    <div class="text-2xl font-bold"><%= @stats[:total_runs] %></div>
    <% if @stats[:success_rate] %>
      <div class="text-xs text-ink-dim mt-1"><%= @stats[:success_rate] %>% success</div>
    <% end %>
  </div>

  <div class="card p-4">
    <div class="text-xs text-ink-mute uppercase tracking-wider mb-1 flex items-center gap-1.5">
      <span class="dot dot-danger"></span> Critical
    </div>
    <div class="text-2xl font-bold text-danger"><%= @stats[:critical] %></div>
    <div class="text-xs text-ink-dim mt-1">across completed runs</div>
  </div>

  <div class="card p-4">
    <div class="text-xs text-ink-mute uppercase tracking-wider mb-1 flex items-center gap-1.5">
      <span class="dot dot-warning"></span> Warnings
    </div>
    <div class="text-2xl font-bold text-warning"><%= @stats[:warning] %></div>
    <div class="text-xs text-ink-dim mt-1">across completed runs</div>
  </div>

  <div class="card p-4">
    <div class="text-xs text-ink-mute uppercase tracking-wider mb-1 flex items-center gap-1.5">
      <span class="dot dot-info"></span> Info
    </div>
    <div class="text-2xl font-bold text-info"><%= @stats[:info] %></div>
    <div class="text-xs text-ink-dim mt-1">across completed runs</div>
  </div>
</div>

<%# Expiring sections side by side %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
  <div class="card p-5">
    <h2 class="text-sm font-bold uppercase tracking-wider text-ink-dim mb-4">Domains expiring soon</h2>
    <% if @expiring_domains.empty? %>
      <p class="text-sm text-ink-mute">No WHOIS runs report a domain expiring in the next <%= DashboardController::EXPIRY_THRESHOLD %> days.</p>
      <%= link_to "Run WHOIS Lookup", tool_path(:whois_lookup), class: "btn btn-ghost text-xs mt-3" %>
    <% else %>
      <ul class="divide-y divide-edge">
        <% @expiring_domains.each do |entry| %>
          <li class="py-2 flex items-center justify-between">
            <div class="min-w-0">
              <%= link_to entry[:target], tool_run_path(entry[:run]),
                    class: "font-medium hover:text-brand truncate block" %>
              <div class="text-xs text-ink-mute font-mono"><%= entry[:expiry] %></div>
            </div>
            <span class="badge <%= entry[:days_until] <= 7 ? 'badge-critical' : entry[:days_until] <= 30 ? 'badge-warning' : 'badge-info' %>">
              <%= entry[:days_until] %>d
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="card p-5">
    <h2 class="text-sm font-bold uppercase tracking-wider text-ink-dim mb-4">SSL certs expiring soon</h2>
    <% if @expiring_certs.empty? %>
      <p class="text-sm text-ink-mute">No SSL runs report a cert expiring in the next <%= DashboardController::EXPIRY_THRESHOLD %> days.</p>
      <%= link_to "Run SSL/TLS Inspection", tool_path(:ssl_inspect), class: "btn btn-ghost text-xs mt-3" %>
    <% else %>
      <ul class="divide-y divide-edge">
        <% @expiring_certs.each do |entry| %>
          <li class="py-2 flex items-center justify-between">
            <div class="min-w-0">
              <%= link_to entry[:target], tool_run_path(entry[:run]),
                    class: "font-medium hover:text-brand truncate block" %>
              <div class="text-xs text-ink-mute">SSL/TLS</div>
            </div>
            <span class="badge <%= entry[:days_until] <= 7 ? 'badge-critical' : entry[:days_until] <= 30 ? 'badge-warning' : 'badge-info' %>">
              <%= entry[:days_until] %>d
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<%# Recent runs %>
<div class="card p-5">
  <div class="flex items-baseline justify-between mb-4">
    <h2 class="text-sm font-bold uppercase tracking-wider text-ink-dim">Recent runs</h2>
    <%= link_to "View all", tool_runs_path, class: "text-xs text-ink-dim hover:text-ink" %>
  </div>

  <% if @recent_runs.empty? %>
    <p class="text-sm text-ink-mute mb-3">No runs yet — pick a tool from the catalog to get started.</p>
    <%= link_to "Browse tools", tools_path, class: "btn btn-ghost text-xs" %>
  <% else %>
    <ul class="divide-y divide-edge">
      <% @recent_runs.each do |run| %>
        <li class="py-2.5 flex items-center justify-between gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <%= link_to run.tool_name, tool_run_path(run), class: "font-medium hover:text-brand truncate" %>
              <%= render "tool_runs/status_badge", tool_run: run %>
            </div>
            <div class="text-xs text-ink-mute font-mono truncate"><%= run.input_summary %></div>
          </div>
          <div class="text-xs text-ink-mute whitespace-nowrap"><%= time_ago_in_words(run.created_at) %> ago</div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
