<section id="result_panel" class="flex-1 min-h-0 overflow-y-auto text-xs">
  <%= turbo_stream_from batch %>
  <div class="flex items-center justify-between px-3 py-2 border-b border-line">
    <span>
      <span class="bg-accent text-bg px-1 font-bold">BULK</span>
      <span class="text-cyan"><%= batch.tool_class&.tool_name || batch.tool_key %></span>
      <span class="text-mute" aria-hidden="true">// <%= batch.domain_count %> domains</span>
    </span>
  </div>
  <%= render "batches/aggregate", batch: batch %>
  <%= render "batches/table", batch: batch %>
</section>
