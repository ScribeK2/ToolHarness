<section id="bulk_form" class="flex-1 min-h-0 overflow-y-auto text-xs p-3">
  <h2 class="text-[11px] tracking-[0.18em] uppercase text-fg font-bold mb-2"><span aria-hidden="true">▸ </span>Bulk Domain Runner</h2>
  <%= form_with url: batches_path, method: :post, data: { turbo: false }, class: "space-y-2 max-w-2xl" do |f| %>
    <div>
      <%= f.label :tool_key, "Tool to run on each domain", class: "mono-label block mb-1" %>
      <%= f.select :tool_key, Tools::BulkRun.selectable_tools, {},
            class: "w-full bg-bg border border-line px-2 py-[3px] text-[11px] text-fg focus:border-accent-2 outline-none" %>
    </div>
    <div>
      <%= f.label :domains, "Domains (one per line, comma, or whitespace separated — max 50)", class: "mono-label block mb-1" %>
      <%= f.text_area :domains, rows: 8, placeholder: "example.com\nanother.com\nthird.org",
            class: "w-full bg-bg border border-line px-2 py-2 text-[11px] text-fg font-mono placeholder:text-mute focus:border-accent-2 outline-none" %>
    </div>
    <%= f.submit "Run bulk", class: "btn btn-primary cursor-pointer" %>
  <% end %>
</section>
