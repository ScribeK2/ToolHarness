<section id="result_panel" class="flex-1 min-h-0 overflow-y-auto px-3 py-2 text-xs">
  <div class="flex items-center justify-between mb-2 text-mute">
    <span><span aria-hidden="true">▸ </span>Runs · <%= @runs.size %> shown<%= " (max 200)" if @runs.size == 200 %></span>
  </div>

  <% if @runs.empty? %>
    <div class="text-mute">no runs match.</div>
  <% else %>
    <div class="border-t border-line">
      <div class="grid grid-cols-[80px_120px_1fr_80px_100px_60px] gap-3 px-2 py-1 border-b border-line mono-label">
        <span>TIME</span><span>TOOL</span><span>TARGET</span><span>STATUS</span><span>ISSUES</span><span>AGE</span>
      </div>
      <% @runs.each_with_index do |run, i| %>
        <% sev = (run.issues || []).group_by { |x| (x["severity"] || x[:severity]).to_s }.transform_values(&:size) %>
        <%= link_to workbench_path(tool: run.tool_key, target: run.input_summary, run: run.id),
                    class: "grid grid-cols-[80px_120px_1fr_80px_100px_60px] gap-3 px-2 py-[2px] border-b border-line/50 hover:bg-elevated text-fg" do %>
          <span class="text-mute"><%= run.created_at.strftime("%H:%M") %></span>
          <span><%= run.tool_key %></span>
          <span class="text-fg-dim truncate"><%= run.input_summary %></span>
          <% if run.status == "completed" %>
            <span class="sev sev-ok"> OK </span>
          <% elsif run.status == "failed" %>
            <span class="sev sev-crit">FAIL</span>
          <% else %>
            <span class="text-mute"><%= run.status %></span>
          <% end %>
          <span class="text-fg-dim">C:<%= sev["critical"] || 0 %> W:<%= sev["warning"] || 0 %> I:<%= sev["info"] || 0 %></span>
          <span class="text-mute text-right"><%= time_ago_in_words(run.created_at).sub("about ", "") %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
