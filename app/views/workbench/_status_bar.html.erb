<footer class="h-[22px] px-3 border-t border-line bg-surface flex items-center justify-between text-[11px]"
        aria-live="polite">
  <span class="flex items-center">
    <span data-mode-badge class="px-1.5 font-bold mr-2 text-bg bg-green">NORMAL</span>
    <span class="text-fg-dim" data-status="context">workbench</span>
  </span>
  <span class="flex items-center gap-3">
    <button type="button"
            data-action="click->theme-picker#open"
            class="text-accent-2 hover:text-fg border border-line px-1.5 py-0 leading-none"
            aria-label="Switch theme"
            title="Switch theme (:theme)">
      <span aria-hidden="true">◆</span> <span data-theme-pill><%= ToolHarness::Themes.default_key %></span>
    </button>
    <span class="text-mute" data-status="hints">/ search · t tools · : cmdline · ? help</span>
  </span>
</footer>
