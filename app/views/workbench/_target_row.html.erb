<% tool_key = @tool_class&.name&.demodulize&.underscore %>
<% fields   = @tool_class&.form_fields || { target: :text } %>
<% primary  = fields.keys.first %>

<section class="border-b border-line bg-surface" data-controller="target-row">
  <%= form_with url: tool_key ? tool_run_create_path(tool_key) : "#",
                method: :post, scope: :tool_run,
                data: { turbo: true },
                class: "flex flex-col" do |f| %>
    <% if fields[primary] == :textarea %>
      <div class="px-3 py-2 flex flex-col gap-2">
        <span class="mono-label">paste headers<span aria-hidden="true"> ›</span></span>
        <%= f.text_area primary, value: @target, rows: 12, spellcheck: "false",
              autocomplete: "off",
              class: "w-full font-mono text-xs bg-surface border border-line p-2",
              data: { workbench_target: "input" } %>
        <div class="flex justify-end">
          <button type="submit" class="btn btn-primary cursor-pointer" aria-label="Run">RUN<span aria-hidden="true"> ⏎</span></button>
        </div>
      </div>
    <% else %>
      <div class="h-10 px-3 flex items-center gap-3">
        <span class="mono-label">target<span aria-hidden="true"> ›</span></span>
        <% normalize_input = @tool_class && %i[domain host].include?(@tool_class.input_type) %>
        <%= f.text_field primary, value: @target,
              autocomplete: "off", spellcheck: "false",
              class: "flex-1",
              data: {
                workbench_target: "input",
                controller: normalize_input ? "domain-normalizer" : nil,
                domain_normalizer_preserve_path_value: normalize_input ? @tool_class.preserve_path_in_input?.to_s : nil
              }.compact %>
        <button type="submit" class="btn btn-primary cursor-pointer" aria-label="Run">RUN<span aria-hidden="true"> ⏎</span></button>
      </div>
    <% end %>

    <% extras = fields.except(primary) %>
    <% if extras.any? %>
      <div class="px-3 pb-2 pt-1 flex items-center gap-4 border-t border-line">
        <% extras.each do |name, type|
             type_sym = type.is_a?(Hash) ? type[:type] : type
             options  = type.is_a?(Hash) ? type[:options] : nil %>
          <div class="flex items-center gap-2">
            <%= f.label name, name.to_s, class: "mono-label" %>
            <% case type_sym
               when :select %>
              <%= f.select name, options, { include_blank: false }, class: "w-28" %>
            <% when :number %>
              <%= f.number_field name, class: "w-20" %>
            <% when :textarea %>
              <%= f.text_area name, rows: 2, class: "w-64" %>
            <% else %>
              <%= f.text_field name, class: "w-28" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
