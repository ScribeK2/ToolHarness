<%# locals: result, run, state %>
<%# The outer div carries the id so turbo_stream.replace("sql_result_panel", …) %>
<%# can be applied repeatedly — without it, the id is lost after the first replace. %>
<% local_run    = local_assigns[:run] %>
<% local_result = local_assigns[:result] %>

<div id="sql_result_panel" class="flex-1 min-h-0 overflow-auto">
  <% if local_result && !local_result.success? %>
    <%= render "workbench/sql/error_block", message: local_result.error_message, code: local_result.error_code %>
  <% end %>

  <% if local_run.present? && local_run.result_data.present? %>
    <%= render "workbench/sql/result_grid", run: local_run %>
  <% elsif state.blank? %>
    <div class="text-mute px-3 py-2"><span aria-hidden="true">▸ </span>no connection — type :c to open the picker</div>
  <% else %>
    <div class="text-mute px-3 py-2"><span aria-hidden="true">▸ </span>ready — write a query above and press Ctrl+⏎</div>
  <% end %>
</div>
