<%
  head_lines = 6
  lines      = value.to_s.split("\n")
  truncated  = lines.length > head_lines
  head_text  = truncated ? "#{lines.first(head_lines).join("\n")}\n  … #{lines.length - head_lines} more lines (`:raw` to expand)" : value
  copy_attrs = { "data-controller" => "copy", "data-action" => "click->copy#copyValue", "data-copy-value" => value, "title" => "click to copy" }
%>
<div class="flex gap-2 py-[1px]">
  <span class="text-mute w-[110px] flex-shrink-0"><%= key %></span>
  <% if truncated %>
    <div class="flex-1" data-truncated>
      <pre class="text-fg whitespace-pre border-l border-line pl-2 cursor-pointer hover:text-accent-2" data-truncated-head <%= tag.attributes(copy_attrs) %>><%= head_text %></pre>
      <pre class="text-fg whitespace-pre border-l border-line pl-2 hidden cursor-pointer hover:text-accent-2" data-truncated-full <%= tag.attributes(copy_attrs) %>><%= value %></pre>
    </div>
  <% elsif value.to_s.include?("\n") %>
    <pre class="text-fg whitespace-pre border-l border-line pl-2 cursor-pointer hover:text-accent-2" <%= tag.attributes(copy_attrs) %>><%= value %></pre>
  <% else %>
    <span class="text-fg cursor-pointer hover:text-accent-2" <%= tag.attributes(copy_attrs) %>><%= value %></span>
  <% end %>
</div>
