<%
  head_lines = 6
  lines      = value.to_s.split("\n")
  truncated  = lines.length > head_lines
  head_text  = truncated ? "#{lines.first(head_lines).join("\n")}\n  … #{lines.length - head_lines} more lines (`:raw` to expand)" : value
%>
<div class="flex gap-2 py-[1px]">
  <span class="text-mute w-[110px] flex-shrink-0"><%= key %></span>
  <% if truncated %>
    <div class="flex-1" data-truncated>
      <pre class="text-fg whitespace-pre border-l border-line pl-2" data-truncated-head><%= head_text %></pre>
      <pre class="text-fg whitespace-pre border-l border-line pl-2 hidden" data-truncated-full><%= value %></pre>
    </div>
  <% elsif value.to_s.include?("\n") %>
    <pre class="text-fg whitespace-pre border-l border-line pl-2"><%= value %></pre>
  <% else %>
    <span class="text-fg"><%= value %></span>
  <% end %>
</div>
