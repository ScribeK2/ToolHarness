<%
  letter = ('a'..'z').to_a[index]
%>
<div class="py-2 border-t border-line first:border-t-0" data-section="<%= letter %>">
  <div class="flex items-center justify-between mb-1">
    <h3 class="text-[11px] tracking-[0.18em] uppercase text-fg font-bold"><span aria-hidden="true">▸ </span><%= section.title %></h3>
    <button type="button"
            class="text-mute hover:text-cyan text-[10px]"
            data-controller="copy"
            data-action="click->copy#copySection"
            data-copy-section-value="<%= letter %>">[y <%= letter %>]</button>
  </div>

  <% if section.table %>
    <table class="w-full text-fg" data-controller="sortable-table">
      <thead>
        <tr class="text-mute text-left">
          <% section.table.columns.each do |col| %>
            <th class="pr-2 <%= 'text-right' if col.numeric %>"
                data-sort-key="<%= col.key %>"
                <%= ('data-sort-as="number"').html_safe if col.numeric %>><%= col.label.upcase %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% section.table.rows.each do |row| %>
          <tr>
            <% section.table.columns.each do |col| %>
              <% cell = row[col.key] %>
              <td class="pr-2 <%= 'text-right text-mute' if col.numeric %> cursor-pointer hover:text-cyan"
                  data-sort-cell="<%= col.key %>"
                  data-sort-value="<%= cell %>"
                  data-controller="copy"
                  data-action="click->copy#copyValue"
                  data-copy-value="<%= cell %>"
                  title="click to copy"><%= cell %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <% section.kvs.each do |k, v| %>
      <%= render "results/kv_row", key: k, value: v %>
    <% end %>

    <% section.issues.each do |issue| %>
      <div class="flex gap-2 py-[1px]">
        <%= render "results/severity_tag", severity: (issue["severity"] || issue[:severity]) %>
        <span class="text-fg"><%= issue["title"] || issue[:title] %><% msg = issue["message"] || issue[:message]; if msg.present? %> — <span class="text-fg-dim"><%= msg %></span><% end %></span>
      </div>
    <% end %>
  <% end %>
</div>
