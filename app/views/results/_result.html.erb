<%= turbo_stream_from tool_run %>
<% if tool_run.result_data.present? %>
  <script type="application/json" id="raw_<%= dom_id(tool_run) %>"><%= JSON.generate(tool_run.result_data).html_safe %></script>
  <script>window.toolRunRawJson = document.getElementById("raw_<%= dom_id(tool_run) %>").textContent;</script>
<% end %>
<% if tool_run.status.in?(ToolRun::TERMINAL_STATUSES) %>
  <template id="full_<%= dom_id(tool_run) %>"><%= tool_run_full_text(tool_run) %></template>
  <script>window.toolRunFullText = document.getElementById("full_<%= dom_id(tool_run) %>").content.textContent;</script>
<% end %>
<div id="<%= dom_id(tool_run) %>" class="text-xs">
  <% case tool_run.status
     when "pending", "processing" %>
    <div class="flex items-center gap-2 text-fg-dim"
         data-controller="run-poller"
         data-run-poller-url-value="<%= tool_run_path(tool_run) %>">
      <span class="spinner"></span>
      <span><span aria-hidden="true">▸ </span><%= tool_run.tool_name.downcase %> · <%= tool_run.input_summary %> · running…</span>
    </div>
  <% else %>
    <%
      custom_partial = tool_run.tool_class&.result_partial ||
                       ToolHarness::Registry.legacy_partial(tool_run.tool_key)
      use_custom     = custom_partial && tool_run.status != "failed"
      presenter      = ToolHarness::ResultPresenter.new(tool_run) unless use_custom
      sections       = presenter&.sections
    %>
    <div class="flex items-center justify-between mb-2 text-mute">
      <span><span aria-hidden="true">▸ </span><%= tool_run.tool_name.downcase %> · <%= tool_run.input_summary %> · <%= tool_run.status == "failed" ? "failed" : "done #{tool_run.execution_time&.round(2)}s" %></span>
      <div class="flex items-center gap-3">
        <% siblings = sibling_tools_for(tool_run) %>
        <% if siblings.any? %>
          <details class="relative" data-controller="dropdown">
            <summary class="text-mute hover:text-accent-2 text-[10px] cursor-pointer list-none">[→] in tool ▾</summary>
            <div class="absolute right-0 z-10 mt-1 bg-elevated border border-line py-1 min-w-[160px]">
              <% siblings.each do |key, name| %>
                <%= link_to name, workbench_path(tool: key, target: tool_run.primary_input),
                      class: "block px-3 py-[2px] text-fg hover:bg-line hover:text-accent-2 whitespace-nowrap" %>
              <% end %>
            </div>
          </details>
        <% end %>
        <% if tool_run.tool_class %>
          <%= button_to tool_run_rerun_path(tool_run),
                class: "text-mute hover:text-accent-2 text-[10px]",
                form_class: "inline" do %>↻ re-run<% end %>
        <% end %>
        <button type="button"
                class="text-mute hover:text-accent-2 text-[10px]"
                data-controller="copy"
                data-action="click->copy#copySummary"
                data-copy-text-value="<%= tool_run_ticket_text(tool_run) %>">[y s] copy summary</button>
        <button type="button"
                class="text-mute hover:text-accent-2 text-[10px]"
                data-controller="copy"
                data-action="click->copy#copyFull">[y F] copy full</button>
      </div>
    </div>

    <% if use_custom %>
      <%= render custom_partial, tool_run: tool_run %>
    <% else %>
      <% sections.each_with_index do |section, i| %>
        <%= render "results/section", section: section, index: i %>
      <% end %>
    <% end %>
  <% end %>
</div>
