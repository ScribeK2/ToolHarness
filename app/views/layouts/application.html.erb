<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ToolHarness" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ToolHarness">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= turbo_include_tags %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base text-ink">
    <% if user_signed_in? %>
      <div class="flex min-h-screen">
        <%# Sidebar %>
        <aside class="hidden md:flex w-64 flex-col border-r border-edge bg-surface">
          <%# Brand %>
          <div class="px-5 py-5 border-b border-edge">
            <%= link_to root_path, class: "flex items-center gap-3" do %>
              <div class="w-9 h-9 rounded-lg bg-brand-mute flex items-center justify-center">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5h2a2 2 0 012 2v2M5 11h14M9 5h2v14H9z"/>
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="font-bold text-base leading-tight">ToolHarness</span>
                <span class="text-xs text-ink-mute font-mono">v0.1</span>
              </div>
            <% end %>
          </div>

          <%# Global quick-search %>
          <form action="<%= search_path %>" method="get"
                class="px-3 pt-4 pb-2"
                data-controller="shortcuts">
            <input type="search" name="q" value="<%= params[:q] if controller_name == 'search' %>"
                   placeholder="Search… ( / )"
                   autocomplete="off" spellcheck="false"
                   data-shortcuts-target="search"
                   class="text-sm">
          </form>

          <%# Nav %>
          <nav class="flex-1 px-3 py-2 space-y-1">
            <%= link_to dashboard_path, class: "nav-link #{'active' if current_page?(dashboard_path)}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10h14V10"/>
              </svg>
              Dashboard
            <% end %>

            <%= link_to tools_path, class: "nav-link #{'active' if request.path.start_with?('/tools')}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a4 4 0 015.6 5.6L7 25l-4 1 1-4L17.4 8.6a4 4 0 012-2.3z"/>
              </svg>
              Tool Catalog
            <% end %>

            <%= link_to tool_runs_path, class: "nav-link #{'active' if request.path.start_with?('/tool_runs')}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Recent Runs
            <% end %>
          </nav>

          <%# User footer %>
          <div class="px-3 py-4 border-t border-edge">
            <div class="flex items-center gap-3 px-3 py-2">
              <div class="w-7 h-7 rounded-full bg-elevated flex items-center justify-center text-xs font-bold text-ink-dim">
                <%= current_user.email.first.upcase %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-xs text-ink-dim truncate"><%= current_user.email %></div>
              </div>
            </div>
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
                class: "nav-link mt-1" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              Sign out
            <% end %>
          </div>
        </aside>

        <%# Main %>
        <div class="flex-1 min-w-0 flex flex-col">
          <%# Mobile top bar %>
          <div class="md:hidden flex items-center justify-between px-4 py-3 border-b border-edge bg-surface">
            <%= link_to root_path, class: "flex items-center gap-2" do %>
              <span class="font-bold">ToolHarness</span>
            <% end %>
            <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete },
                class: "text-xs text-ink-dim" %>
          </div>

          <main class="flex-1 px-6 md:px-10 py-8 max-w-6xl w-full">
            <%# Flash %>
            <% if notice %>
              <div class="mb-6 card px-4 py-3 border-l-2 flex items-center gap-3" style="border-left-color: var(--color-success);">
                <span class="dot dot-success"></span>
                <span class="text-sm"><%= notice %></span>
              </div>
            <% end %>
            <% if alert %>
              <div class="mb-6 card px-4 py-3 border-l-2 flex items-center gap-3" style="border-left-color: var(--color-danger);">
                <span class="dot dot-danger"></span>
                <span class="text-sm"><%= alert %></span>
              </div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%# Sign-in / unauthenticated %>
      <main class="min-h-screen flex items-center justify-center px-6">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
