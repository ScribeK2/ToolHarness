<div id="<%= dom_id(tool_run) %>" class="space-y-6">
  <%# Header %>
  <div>
    <div class="flex items-center gap-2 text-sm text-ink-dim mb-2">
      <%= link_to "Tools", tools_path, class: "hover:text-ink" %>
      <span class="text-ink-mute">/</span>
      <%= link_to tool_run.tool_name, tool_path(tool_run.tool_key), class: "hover:text-ink" %>
    </div>

    <div class="flex items-start gap-4 mb-3">
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl font-bold mb-1 truncate"><%= tool_run.tool_name %></h1>
        <% if tool_run.input_summary.present? %>
          <p class="text-ink-dim font-mono text-sm truncate"><%= tool_run.input_summary %></p>
        <% end %>
      </div>
      <%= render "tool_runs/status_badge", tool_run: tool_run %>
    </div>

    <% if %w[completed failed].include?(tool_run.status) %>
      <div class="flex flex-wrap gap-2">
        <button type="button"
                class="btn btn-ghost text-xs"
                data-controller="clipboard"
                data-action="click->clipboard#copy"
                data-clipboard-text-value="<%= tool_run_ticket_text(tool_run) %>"
                data-clipboard-copied-label-value="Copied to clipboard">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/>
          </svg>
          Copy for ticket
        </button>

        <%= form_with url: tool_run_create_path(tool_run.tool_key), method: :post,
              scope: :tool_run, data: { turbo: false }, class: "inline" do |f| %>
          <% (tool_run.input || {}).each do |k, v| %>
            <%= f.hidden_field k, value: v %>
          <% end %>
          <%= f.submit "Run again", class: "btn btn-ghost text-xs cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Status-specific content %>
  <% case tool_run.status
     when "pending", "processing" %>
    <div class="card p-6 flex items-center gap-3 animate-pulse-soft">
      <span class="spinner"></span>
      <div>
        <div class="font-medium"><%= tool_run.status == "pending" ? "Queued, waiting to start..." : "Running..." %></div>
        <div class="text-sm text-ink-dim mt-0.5">Results will appear automatically when the run finishes.</div>
      </div>
    </div>

  <% when "failed" %>
    <div class="card p-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="dot dot-danger"></span>
        <span class="text-danger font-semibold">Run failed</span>
      </div>
      <% if tool_run.error.present? %>
        <pre class="code-well whitespace-pre-wrap"><%= tool_run.error %></pre>
      <% end %>
    </div>

  <% when "completed" %>
    <% if tool_run.summary.present? %>
      <div class="card p-5">
        <div class="text-xs text-ink-mute uppercase tracking-wider mb-1.5">Summary</div>
        <p class="text-lg leading-snug"><%= tool_run.summary %></p>
      </div>
    <% end %>

    <% if tool_run.issues.any? %>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink-dim mb-3">
          <%= pluralize(tool_run.issues.size, "issue") %>
        </h2>
        <div class="space-y-2">
          <% %w[critical warning info].each do |severity| %>
            <% issues = tool_run.issues.select { |i| (i["severity"] || i[:severity]) == severity } %>
            <% issues.each do |issue| %>
              <%= render "tool_runs/issue_card", issue: issue %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if tool_run.recommendations.any? %>
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-ink-dim mb-3">Recommendations</h2>
        <div class="space-y-2">
          <% tool_run.recommendations.each do |rec|
               r = rec.is_a?(Hash) ? rec.with_indifferent_access : rec %>
            <div class="card p-4">
              <div class="font-medium mb-1"><%= r[:title] %></div>
              <% if r[:description].present? %>
                <p class="text-sm text-ink-dim"><%= r[:description] %></p>
              <% end %>
              <% if r[:example].present? %>
                <pre class="code-well mt-2 whitespace-pre-wrap"><%= r[:example] %></pre>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if tool_run.result_data.present? %>
      <details class="card overflow-hidden">
        <summary class="px-5 py-3 cursor-pointer text-sm font-medium text-ink-dim hover:text-ink select-none">
          Raw data (<%= tool_run.result_data.keys.size %> fields)
        </summary>
        <pre class="code-well rounded-none border-0 border-t border-edge whitespace-pre-wrap max-h-96 overflow-auto"><%= JSON.pretty_generate(tool_run.result_data) %></pre>
      </details>
    <% end %>
  <% end %>

  <%# Footer: timing %>
  <div class="text-xs text-ink-mute font-mono pt-2 border-t border-edge flex flex-wrap gap-x-4 gap-y-1">
    <span>Run #<%= tool_run.id %></span>
    <% if tool_run.execution_time %>
      <span><%= tool_run.execution_time.round(3) %>s</span>
    <% end %>
    <span><%= time_ago_in_words(tool_run.created_at) %> ago</span>
    <% if tool_run.cached? %>
      <span class="text-info">cached</span>
    <% end %>
  </div>
</div>
