<% case tool_run.status
   when "pending" %>
  <span class="badge badge-neutral"><span class="dot dot-muted"></span> Pending</span>
<% when "processing" %>
  <span class="badge badge-info"><span class="dot dot-info animate-pulse-soft"></span> Running</span>
<% when "completed" %>
  <% severities = tool_run.issues.map { |i| (i["severity"] || i[:severity]).to_s } %>
  <% if severities.include?("critical") %>
    <span class="badge badge-critical">Critical</span>
  <% elsif severities.include?("warning") %>
    <span class="badge badge-warning">Warnings</span>
  <% else %>
    <span class="badge badge-success">Clean</span>
  <% end %>
<% when "failed" %>
  <span class="badge badge-critical">Failed</span>
<% end %>
