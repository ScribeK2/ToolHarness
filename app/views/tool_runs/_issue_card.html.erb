<% issue = issue.is_a?(Hash) ? issue.with_indifferent_access : {} %>
<% severity = issue[:severity].to_s.presence || "info" %>
<% border_color = { "critical" => "var(--color-danger)", "warning" => "var(--color-warning)", "info" => "var(--color-info)" }[severity] || "var(--color-edge)" %>

<div class="card p-4 border-l-2" style="border-left-color: <%= border_color %>;">
  <div class="flex items-center gap-2 mb-1.5">
    <span class="badge badge-<%= severity %>"><%= severity %></span>
    <span class="font-medium"><%= issue[:title] %></span>
  </div>
  <% if issue[:message].present? %>
    <p class="text-sm text-ink-dim leading-relaxed"><%= issue[:message] %></p>
  <% end %>
  <% if issue[:recommendation].present? %>
    <div class="mt-2 pt-2 border-t border-edge text-sm">
      <span class="text-ink-mute">Recommendation: </span>
      <span class="text-ink-dim"><%= issue[:recommendation] %></span>
    </div>
  <% end %>
</div>
