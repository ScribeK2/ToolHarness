<%# Custom partial for Tools::Credentials. Reads the store directly (no controller
    locals on the initial layout render); the EntriesController passes :error. %>
<% entries = ToolHarness::CredentialStore.new.entries %>
<% error   = local_assigns[:error] %>

<section id="credentials_pane" class="flex-1 min-h-0 overflow-y-auto text-xs p-3">
  <h2 class="text-[11px] tracking-[0.18em] uppercase text-fg font-bold mb-2"><span aria-hidden="true">▸ </span>Credentials</h2>

  <% if error.present? %>
    <div class="mb-2 px-2 py-1 bg-elevated text-red text-[11px]"><span aria-hidden="true">⚠ </span><%= error %></div>
  <% end %>

  <% if entries.any? %>
    <table class="w-full text-fg mb-4">
      <thead>
        <tr class="text-mute text-left">
          <th class="pr-2">ID</th><th class="pr-2">KIND</th><th class="pr-2">LABEL</th>
          <th class="pr-2">HOST</th><th class="pr-2">STATUS</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% entries.each do |e| %>
          <tr>
            <td class="pr-2"><%= e[:id] %></td>
            <td class="pr-2 text-mute"><%= e[:kind] %></td>
            <td class="pr-2"><%= e[:label] %></td>
            <td class="pr-2 text-mute"><%= "#{e[:user]}@#{e[:host]}" if e[:kind] == "host" %></td>
            <td class="pr-2 <%= e[:locked] ? 'text-red' : 'text-green' %>"><%= e[:locked] ? "🔒 locked" : "set ✓" %></td>
            <td class="pr-2 text-right">
              <%= button_to "delete", credentials_entry_path(e[:id]), method: :delete,
                    form_class: "inline", class: "text-mute hover:text-red text-[10px]",
                    data: { turbo_confirm: "Delete credential '#{e[:id]}'?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-mute mb-4">No credentials stored.</p>
  <% end %>

  <%= form_with url: credentials_entries_path, method: :post, class: "space-y-1 max-w-md" do |f| %>
    <div class="text-mute"><span aria-hidden="true">// </span>add credential</div>
    <%= f.select :kind, [["API key", "api_key"], ["Host credential", "host"]], {},
          class: "w-full bg-bg border border-line px-2 py-[2px] text-[11px] text-fg focus:border-accent-2 outline-none" %>
    <%= f.text_field :id, placeholder: "id (e.g. ipinfo)",
          class: "w-full bg-bg border border-line px-2 py-[2px] text-[11px] text-fg placeholder:text-mute focus:border-accent-2 outline-none" %>
    <%= f.text_field :label, placeholder: "label (optional)",
          class: "w-full bg-bg border border-line px-2 py-[2px] text-[11px] text-fg placeholder:text-mute focus:border-accent-2 outline-none" %>
    <%= f.text_field :host, placeholder: "host (host credentials only)",
          class: "w-full bg-bg border border-line px-2 py-[2px] text-[11px] text-fg placeholder:text-mute focus:border-accent-2 outline-none" %>
    <%= f.text_field :user, placeholder: "user (host credentials only)",
          class: "w-full bg-bg border border-line px-2 py-[2px] text-[11px] text-fg placeholder:text-mute focus:border-accent-2 outline-none" %>
    <%= f.password_field :secret, placeholder: "secret",
          class: "w-full bg-bg border border-line px-2 py-[2px] text-[11px] text-fg placeholder:text-mute focus:border-accent-2 outline-none" %>
    <%= f.submit "Save credential",
          class: "bg-elevated text-fg px-3 py-[2px] text-[11px] hover:text-accent-2 cursor-pointer" %>
  <% end %>
</section>
